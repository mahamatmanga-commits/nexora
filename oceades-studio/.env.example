# Clé API Anthropic (côté serveur uniquement, jamais exposée au navigateur).
# Sans clé, les fonctions IA sont désactivées et clairement signalées dans l'interface.
ANTHROPIC_API_KEY=

# Modèle utilisé par l'assistant (optionnel)
OCEADES_AI_MODEL=claude-opus-5-5

# Emplacements de stockage locaux (optionnels)
OCEADES_DATA_DIR=./data
OCEADES_STORAGE_DIR=./storage

# Taille max d'un fichier importé dans la médiathèque, en Mo (optionnel)
OCEADES_MAX_UPLOAD_MB=1024

# Protection d'accès (optionnelle) : si défini, un mot de passe est demandé pour ouvrir l'application.
OCEADES_PASSWORD=
